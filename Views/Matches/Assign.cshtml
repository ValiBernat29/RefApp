@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Assign Referees";
    var matchId = (int)ViewBag.MatchId;
    var afToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<meta name="af-token" content="@afToken" />
<link rel="stylesheet" href="~/dist/app.css" asp-append-version="true" />

<main class="max-w-[1440px] mx-auto p-8 space-y-6">

    <!-- Page Header -->
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Assign Referees</h1>
        <nav class="text-sm text-gray-400 mt-0.5">
            <a asp-controller="Board" asp-action="Index" class="hover:text-gray-600">Dashboard</a>
            <span class="mx-1">•</span>
            <a asp-controller="Matches" asp-action="Index" class="hover:text-gray-600">Matches</a>
            <span class="mx-1">•</span><span>Assign</span>
        </nav>
    </div>

    <div id="assign-app" data-match-id="@matchId"></div>

</main>

@section Scripts {
    <script type="module" src="~/dist/assign.js" asp-append-version="true"></script>
}
