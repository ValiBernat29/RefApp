@using RefApp.Models
@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Referee Fleet";
    var withCar    = Model.Count(r => r.HasCar);
    var withoutCar = Model.Count(r => !r.HasCar);
}

<main class="max-w-[1440px] mx-auto p-8 space-y-8">

    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Referee Fleet</h1>
            <nav class="text-sm text-gray-400 mt-0.5">
                <a asp-controller="Board" asp-action="Index" class="hover:text-gray-600">Dashboard</a>
                <span class="mx-1">•</span>
                <a asp-controller="Board" asp-action="Users" class="hover:text-gray-600">Users</a>
                <span class="mx-1">•</span><span>Fleet</span>
            </nav>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="bg-white rounded-xl card-shadow p-5 flex items-center gap-4">
            <div class="p-3 bg-sky-100 rounded-xl">
                <svg class="h-6 w-6 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M17 20H7m10 0v-2a3 3 0 00-3-3H9a3 3 0 00-3 3v2m12-10a4 4 0 10-8 0 4 4 0 008 0z"
                          stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                </svg>
            </div>
            <div>
                <p class="text-xs text-gray-400 font-semibold uppercase tracking-wide">Total Referees</p>
                <p class="text-2xl font-bold text-gray-800">@Model.Count()</p>
            </div>
        </div>
        <div class="bg-white rounded-xl card-shadow p-5 flex items-center gap-4">
            <div class="p-3 bg-emerald-100 rounded-xl">
                <!-- car icon -->
                <svg class="h-6 w-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M5 17H3a2 2 0 01-2-2V9a2 2 0 012-2h1l2-4h8l2 4h1a2 2 0 012 2v6a2 2 0 01-2 2h-2m-6 0h4m-4 0a2 2 0 100 4 2 2 0 000-4zm4 0a2 2 0 100 4 2 2 0 000-4z"
                          stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                </svg>
            </div>
            <div>
                <p class="text-xs text-gray-400 font-semibold uppercase tracking-wide">Have a Car</p>
                <p class="text-2xl font-bold text-emerald-600">@withCar</p>
            </div>
        </div>
        <div class="bg-white rounded-xl card-shadow p-5 flex items-center gap-4">
            <div class="p-3 bg-amber-100 rounded-xl">
                <svg class="h-6 w-6 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                          stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                </svg>
            </div>
            <div>
                <p class="text-xs text-gray-400 font-semibold uppercase tracking-wide">No Car</p>
                <p class="text-2xl font-bold text-amber-600">@withoutCar</p>
            </div>
        </div>
    </div>

    <!-- Info Banner -->
    <div class="bg-sky-50 border border-sky-200 rounded-xl px-5 py-4 text-sm text-sky-800 flex items-start gap-3">
        <svg class="h-5 w-5 mt-0.5 flex-shrink-0 text-sky-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
        </svg>
        <span>The auto-allocation engine ensures <strong>at least one referee with a car</strong> is assigned per match. Use the toggles below to keep car availability up to date.</span>
    </div>

    <!-- Fleet Table -->
    <section class="bg-white rounded-xl card-shadow overflow-hidden">
        <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between">
            <h2 class="text-lg font-bold text-gray-800">Referee Car Status</h2>
            <span class="text-xs text-gray-400">Toggle saves automatically</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left" id="fleet-table">
                <thead>
                    <tr class="bg-gray-50 text-gray-500 text-xs font-medium uppercase tracking-wider">
                        <th class="px-6 py-3">Name</th>
                        <th class="px-6 py-3">Rank</th>
                        <th class="px-6 py-3">Home City</th>
                        <th class="px-6 py-3">Car Status</th>
                        <th class="px-6 py-3">Toggle</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100" id="fleet-tbody">
                    @foreach (var ref_ in Model)
                    {
                        var name = ref_.DisplayName ?? ref_.UserName ?? ref_.Email ?? "—";
                        <tr class="text-gray-700 hover:bg-gray-50/50 transition-colors" id="row-@ref_.Id">
                            <td class="px-6 py-4 font-medium flex items-center gap-2">
                                @name
                            </td>
                            <td class="px-6 py-4 text-sm">
                                <span class="inline-block bg-sky-50 text-sky-700 border border-sky-200 text-xs font-semibold px-2 py-0.5 rounded-full">
                                    @ref_.Rank
                                </span>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">@(ref_.HomeCity ?? "—")</td>
                            <td class="px-6 py-4" id="status-@ref_.Id">
                                @if (ref_.HasCar)
                                {
                                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path d="M5 17H3a2 2 0 01-2-2V9a2 2 0 012-2h1l2-4h8l2 4h1a2 2 0 012 2v6a2 2 0 01-2 2h-2m-6 0h4m-4 0a2 2 0 100 4 2 2 0 000-4zm4 0a2 2 0 100 4 2 2 0 000-4z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                                        </svg>
                                        Has Car
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-500 border border-gray-200">
                                        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                                        </svg>
                                        No Car
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                <button type="button"
                                        class="car-toggle-btn relative inline-flex h-6 w-11 items-center rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-sky-400 focus:ring-offset-2 @(ref_.HasCar ? "bg-emerald-500" : "bg-gray-300")"
                                        data-id="@ref_.Id"
                                        data-has-car="@ref_.HasCar.ToString().ToLower()"
                                        aria-label="Toggle car for @name"
                                        title="@(ref_.HasCar ? "Click to mark as no car" : "Click to mark as has car")">
                                    <span class="@(ref_.HasCar ? "translate-x-6" : "translate-x-1") inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform duration-200"></span>
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-10 text-center text-gray-400 text-sm">No referees found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</main>

@section Scripts {
<script>
    const antiForgeryToken = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

    document.querySelectorAll('.car-toggle-btn').forEach(function(btn) {
        btn.addEventListener('click', async function() {
            const id = this.dataset.id;
            const currentHasCar = this.dataset.hasCar === 'true';

            // Optimistic UI update
            setCarStatus(id, !currentHasCar);

            try {
                const response = await fetch('/Board/ToggleCar', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiForgeryToken
                    },
                    body: 'id=' + encodeURIComponent(id)
                });

                if (!response.ok) {
                    // Revert on failure
                    setCarStatus(id, currentHasCar);
                    alert('Failed to update car status. Please try again.');
                    return;
                }

                const data = await response.json();
                setCarStatus(id, data.hasCar);
                updateSummaryCounters();
            } catch (e) {
                // Revert on network error
                setCarStatus(id, currentHasCar);
                alert('Network error. Please try again.');
            }
        });
    });

    function setCarStatus(id, hasCar) {
        const btn = document.querySelector('[data-id="' + id + '"]');
        if (!btn) return;

        btn.dataset.hasCar = hasCar.toString();

        // Toggle switch styling
        if (hasCar) {
            btn.classList.remove('bg-gray-300');
            btn.classList.add('bg-emerald-500');
            btn.querySelector('span').classList.remove('translate-x-1');
            btn.querySelector('span').classList.add('translate-x-6');
            btn.title = 'Click to mark as no car';
        } else {
            btn.classList.remove('bg-emerald-500');
            btn.classList.add('bg-gray-300');
            btn.querySelector('span').classList.remove('translate-x-6');
            btn.querySelector('span').classList.add('translate-x-1');
            btn.title = 'Click to mark as has car';
        }

        // Update status badge
        const statusCell = document.getElementById('status-' + id);
        if (statusCell) {
            if (hasCar) {
                statusCell.innerHTML = `<span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path d="M5 17H3a2 2 0 01-2-2V9a2 2 0 012-2h1l2-4h8l2 4h1a2 2 0 012 2v6a2 2 0 01-2 2h-2m-6 0h4m-4 0a2 2 0 100 4 2 2 0 000-4zm4 0a2 2 0 100 4 2 2 0 000-4z" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/>
                    </svg>
                    Has Car</span>`;
            } else {
                statusCell.innerHTML = `<span class="inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-500 border border-gray-200">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                    </svg>
                    No Car</span>`;
            }
        }
    }

    function updateSummaryCounters() {
        const allBtns = document.querySelectorAll('.car-toggle-btn');
        const withCar = Array.from(allBtns).filter(b => b.dataset.hasCar === 'true').length;
        const withoutCar = allBtns.length - withCar;

        // Find and update the stat cards (emerald = with car, amber = without)
        const statNums = document.querySelectorAll('.text-2xl.font-bold');
        if (statNums.length >= 3) {
            statNums[1].textContent = withCar;
            statNums[2].textContent = withoutCar;
        }
    }
</script>
}
