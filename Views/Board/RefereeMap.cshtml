@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    Layout = null;
    var afToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="af-token" content="@Html.Raw(afToken)" />
    <title>Route Map &middot; RefApp</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *{box-sizing:border-box;margin:0;padding:0}
        body{font-family:'Inter',sans-serif;display:flex;height:100vh;overflow:hidden;background:#0f172a}

        #panel{width:370px;flex-shrink:0;background:#1e293b;border-right:1px solid #334155;display:flex;flex-direction:column;overflow:hidden}

        #panel-header{padding:14px 18px;background:linear-gradient(135deg,#0ea5e9,#6366f1);display:flex;align-items:center;gap:10px}
        #panel-header a{color:rgba(255,255,255,.8);text-decoration:none;font-size:12px}
        #panel-header a:hover{color:#fff}
        #panel-header h1{font-size:15px;font-weight:700;color:#fff}
        #panel-header .sub{font-size:11px;color:rgba(255,255,255,.7)}

        .psec{padding:12px 16px;border-bottom:1px solid #334155}
        .plabel{display:block;font-size:10px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px}

        select.psel,input.pinp{width:100%;background:#0f172a;border:1px solid #334155;border-radius:8px;padding:8px 10px;color:#e2e8f0;font-size:13px;font-family:inherit;outline:none}
        select.psel:focus,input.pinp:focus{border-color:#0ea5e9}
        select.psel option{background:#1e293b}

        #assign-panel{padding:12px 16px;border-bottom:1px solid #334155;display:none}
        #assign-panel.visible{display:block}
        .assign-title{font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px}

        .slot-card{display:flex;align-items:center;gap:10px;padding:9px 11px;border-radius:9px;border:1.5px solid #334155;margin-bottom:6px;cursor:pointer;transition:all .15s;background:#0f172a}
        .slot-card:hover{border-color:#475569}
        .slot-card.active{border-color:#0ea5e9;background:rgba(14,165,233,.08);box-shadow:0 0 0 3px rgba(14,165,233,.15)}

        .slot-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
        .slot-dot.main{background:#0ea5e9}
        .slot-dot.asst{background:#a78bfa}

        .slot-info{flex:1;min-width:0}
        .slot-role{font-size:10px;color:#64748b;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
        .slot-name{font-size:13px;font-weight:600;color:#e2e8f0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:1px}
        .slot-hint{font-size:12px;color:#475569;font-style:italic;margin-top:1px}

        .slot-clear{background:none;border:none;color:#475569;cursor:pointer;font-size:16px;padding:2px 4px;line-height:1;flex-shrink:0}
        .slot-clear:hover{color:#f87171}

        .active-hint{font-size:11px;color:#0ea5e9;margin-top:6px;text-align:center}
        @@keyframes pulse{0%,100%{opacity:.6}50%{opacity:1}}
        .active-hint{animation:pulse 1.5s ease-in-out infinite}

        #save-btn{width:100%;margin-top:10px;padding:10px;border-radius:9px;background:linear-gradient(135deg,#10b981,#0ea5e9);border:none;color:#fff;font-size:13px;font-weight:700;cursor:pointer;transition:opacity .15s}
        #save-btn:hover{opacity:.9}
        #save-btn:disabled{opacity:.4;cursor:not-allowed}
        #save-msg{font-size:12px;text-align:center;margin-top:6px;min-height:16px}
        #save-msg.ok{color:#34d399}
        #save-msg.err{color:#f87171}

        .route-row{display:flex;gap:8px;align-items:center}
        #route-btn{background:linear-gradient(135deg,#0ea5e9,#6366f1);color:#fff;border:none;border-radius:8px;padding:8px 12px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap}
        #route-btn:disabled{opacity:.5}
        .buf-row{display:flex;align-items:center;gap:8px;margin-top:8px}
        .buf-row label{font-size:11px;color:#94a3b8;white-space:nowrap}
        #buffer-km{flex:1;accent-color:#0ea5e9}
        #buffer-val{font-size:12px;font-weight:600;color:#0ea5e9;min-width:38px;text-align:right}

        #route-info{padding:8px 16px;background:#0f172a;border-bottom:1px solid #1e293b;display:none;gap:16px}
        #route-info.visible{display:flex}
        .ri-stat span:first-child{display:block;font-size:10px;color:#64748b;text-transform:uppercase;letter-spacing:.05em}
        .ri-stat span:last-child{font-size:14px;font-weight:700;color:#e2e8f0}

        #ref-list-hdr{padding:8px 16px 4px;font-size:10px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.06em}
        #ref-list{flex:1;overflow-y:auto;padding:6px 10px}
        #ref-list::-webkit-scrollbar{width:4px}
        #ref-list::-webkit-scrollbar-thumb{background:#334155;border-radius:2px}

        .rc{display:flex;align-items:center;gap:9px;padding:8px 10px;border-radius:9px;margin-bottom:3px;cursor:pointer;transition:background .12s;border:1.5px solid transparent}
        .rc:hover{background:#0f172a}
        .rc.on-route{background:rgba(16,185,129,.08);border-color:rgba(16,185,129,.25)}
        .rc.assigned-here{background:rgba(99,102,241,.1);border-color:rgba(99,102,241,.3)}
        .rc.no-coords{opacity:.4;pointer-events:none}

        .rc-av{width:34px;height:34px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;flex-shrink:0;background:#334155;color:#94a3b8}
        .rc.on-route .rc-av{background:rgba(16,185,129,.25);color:#34d399}
        .rc.assigned-here .rc-av{background:rgba(99,102,241,.3);color:#a5b4fc}

        .rc-info{flex:1;min-width:0}
        .rc-name{font-size:13px;font-weight:600;color:#e2e8f0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .rc-meta{font-size:11px;color:#64748b;margin-top:1px}
        .rc-tags{display:flex;gap:3px;flex-wrap:wrap;margin-top:3px}
        .tag{padding:1px 6px;border-radius:999px;font-size:10px;font-weight:600}
        .tag-car{background:rgba(16,185,129,.15);color:#34d399}
        .tag-main{background:rgba(14,165,233,.15);color:#38bdf8}
        .tag-asst{background:rgba(168,85,247,.15);color:#c084fc}
        .tag-km{background:rgba(251,191,36,.1);color:#fbbf24}
        .tag-asgn{background:rgba(99,102,241,.2);color:#a5b4fc}

        .rc-assign-btn{background:none;border:1px solid #334155;border-radius:6px;color:#64748b;font-size:11px;padding:3px 7px;cursor:pointer;white-space:nowrap;flex-shrink:0;transition:all .12s}
        .rc-assign-btn:hover{border-color:#0ea5e9;color:#0ea5e9}
        .rc-assign-btn.hidden{display:none}

        #legend{padding:10px 16px;border-top:1px solid #334155;display:flex;gap:12px;flex-wrap:wrap}
        .leg{display:flex;align-items:center;gap:5px;font-size:10px;color:#94a3b8}
        .leg-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}

        #map{flex:1;position:relative}
        #loading{position:absolute;inset:0;background:rgba(15,23,42,.85);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;gap:12px}
        #loading p{color:#94a3b8;font-size:14px}
        .spinner{width:36px;height:36px;border:3px solid #334155;border-top-color:#0ea5e9;border-radius:50%;animation:spin .8s linear infinite}
        @@keyframes spin{to{transform:rotate(360deg)}}

        #map-hint{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);background:rgba(30,41,59,.92);backdrop-filter:blur(8px);border:1px solid #334155;border-radius:14px;padding:24px 32px;text-align:center;z-index:1000;pointer-events:none}
        #map-hint .icon{font-size:40px;margin-bottom:8px}
        #map-hint p{color:#94a3b8;font-size:13px;margin-top:6px}

        .leaflet-popup-content-wrapper{background:#1e293b;border:1px solid #334155;border-radius:10px;color:#e2e8f0}
        .leaflet-popup-tip{background:#1e293b}
        .leaflet-popup-content{margin:12px 14px;font-family:'Inter',sans-serif;font-size:13px}
        .pp-title{font-weight:700;font-size:14px;margin-bottom:4px}
        .pp-row{color:#94a3b8;margin-top:3px}
        .pp-row b{color:#e2e8f0}
        .pp-assign-btn{display:block;margin-top:8px;width:100%;padding:6px;border-radius:7px;background:linear-gradient(135deg,#0ea5e9,#6366f1);color:#fff;font-size:12px;font-weight:600;border:none;cursor:pointer}
        .pp-assign-btn:hover{opacity:.85}
    </style>
</head>
<body>

<div id="panel">

    <div id="panel-header">
        <div style="flex:1">
            <a href="/Board">&larr; Dashboard</a>
            <h1>Route Map</h1>
            <span class="sub">Arad County &middot; Referee Locations</span>
        </div>
    </div>

    <div class="psec">
        <label class="plabel">Select Match</label>
        <select id="match-select" class="psel">
            <option value="">&mdash; pick a match &mdash;</option>
        </select>
    </div>

    <div id="assign-panel">
        <div class="assign-title">Assign Referees</div>

        <div class="slot-card" id="slot-main" onclick="activateSlot('main')">
            <div class="slot-dot main"></div>
            <div class="slot-info">
                <div class="slot-role">Main Referee</div>
                <div class="slot-name" id="slot-main-name" style="display:none"></div>
                <div class="slot-hint" id="slot-main-hint">Click to activate, then pick a ref</div>
            </div>
            <button class="slot-clear" id="slot-main-clear" style="display:none" onclick="clearSlot(event,'main')">&times;</button>
        </div>

        <div class="slot-card" id="slot-asst1" onclick="activateSlot('asst1')">
            <div class="slot-dot asst"></div>
            <div class="slot-info">
                <div class="slot-role">Assistant 1</div>
                <div class="slot-name" id="slot-asst1-name" style="display:none"></div>
                <div class="slot-hint" id="slot-asst1-hint">Click to activate, then pick a ref</div>
            </div>
            <button class="slot-clear" id="slot-asst1-clear" style="display:none" onclick="clearSlot(event,'asst1')">&times;</button>
        </div>

        <div class="slot-card" id="slot-asst2" onclick="activateSlot('asst2')">
            <div class="slot-dot asst"></div>
            <div class="slot-info">
                <div class="slot-role">Assistant 2</div>
                <div class="slot-name" id="slot-asst2-name" style="display:none"></div>
                <div class="slot-hint" id="slot-asst2-hint">Click to activate, then pick a ref</div>
            </div>
            <button class="slot-clear" id="slot-asst2-clear" style="display:none" onclick="clearSlot(event,'asst2')">&times;</button>
        </div>

        <div class="active-hint" id="active-hint" style="display:none">
            &darr; Click a referee below or on the map
        </div>

        <button id="save-btn" onclick="saveAssignment()">Save Assignments</button>
        <div id="save-msg"></div>
    </div>

    <div class="psec">
        <label class="plabel">Route From</label>
        <div class="route-row">
            <input id="origin-city" class="pinp" type="text" value="Arad" placeholder="Origin city..." style="flex:1"/>
            <button id="route-btn" onclick="computeRoute()">Show Route</button>
        </div>
        <div class="buf-row">
            <label>Buffer &plusmn;</label>
            <input type="range" id="buffer-km" min="2" max="30" value="10" step="1" oninput="onBufferChange(this.value)" />
            <span id="buffer-val">10 km</span>
        </div>
    </div>

    <div id="route-info">
        <div class="ri-stat"><span>Distance</span><span id="ri-dist">&mdash;</span></div>
        <div class="ri-stat"><span>Duration</span><span id="ri-dur">&mdash;</span></div>
        <div class="ri-stat"><span>On Route</span><span id="ri-onroute">&mdash;</span></div>
    </div>

    <div id="ref-list-hdr">Referees <span id="ref-count" style="color:#0ea5e9"></span></div>
    <div id="ref-list"></div>

    <div id="legend">
        <div class="leg"><div class="leg-dot" style="background:#3b82f6"></div> Referee</div>
        <div class="leg"><div class="leg-dot" style="background:#10b981"></div> On route</div>
        <div class="leg"><div class="leg-dot" style="background:#6366f1"></div> Assigned</div>
        <div class="leg"><div class="leg-dot" style="background:#f97316"></div> Match venue</div>
    </div>
</div>

<div id="map">
    <div id="loading"><div class="spinner"></div><p>Loading...</p></div>
    <div id="map-hint" style="display:none">
        <div class="icon">&#x1F5FA;</div>
        <strong style="color:#e2e8f0">Select a match above</strong>
        <p>The road route + buffer zone will appear here.<br>Refs within the buffer are highlighted as "on the way".</p>
    </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@turf/turf@@6.5.0/turf.min.js"></script>

<script>
const ARAD_CENTER = [46.1866, 21.3123];
const OSRM_BASE   = 'https://router.project-osrm.org/route/v1/driving';
const AF_TOKEN    = document.querySelector('meta[name="af-token"]').content;

let MAP, REFS = [], MATCHES = [], SELECTED_MATCH = null;
let refMarkers = {}, matchMarkerObj = null;
let routeLayer = null, bufferLayer = null, routeGeoJSON = null;
let currentOnRouteIds = [], currentDistMap = {};

const slots = { main: null, asst1: null, asst2: null };
let activeSlot = null;

document.addEventListener('DOMContentLoaded', async () => {
    MAP = L.map('map', { zoomControl: false }).setView(ARAD_CENTER, 10);
    L.control.zoom({ position: 'topright' }).addTo(MAP);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 19
    }).addTo(MAP);

    L.circleMarker(ARAD_CENTER, { radius: 8, fillColor: '#f59e0b', color: '#fff', weight: 2, fillOpacity: .9 })
        .addTo(MAP)
        .bindPopup('<div class="pp-title">Arad</div><div class="pp-row">Route origin</div>');

    await loadData();
    document.getElementById('loading').style.display = 'none';
    document.getElementById('map-hint').style.display = 'block';
});

async function loadData() {
    const res  = await fetch('/Board/MapData');
    const data = await res.json();
    REFS    = data.referees;
    MATCHES = data.matches;
    populateDropdown();
    renderRefMarkers();
    renderRefList();
}

function populateDropdown() {
    const sel = document.getElementById('match-select');
    MATCHES.forEach(m => {
        const opt = document.createElement('option');
        opt.value = m.id;
        opt.textContent = m.date + '  \u00B7  ' + m.homeTeam + ' vs ' + m.awayTeam + (!m.lat ? ' (no coords)' : '');
        sel.appendChild(opt);
    });
    sel.addEventListener('change', onMatchSelected);
}

function refIcon(color, label) {
    return L.divIcon({
        className: '',
        iconSize: [32, 32], iconAnchor: [16, 16], popupAnchor: [0, -18],
        html: '<div style="width:32px;height:32px;border-radius:50%;background:' + color + ';border:2px solid rgba(255,255,255,.6);display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;font-weight:700;box-shadow:0 2px 8px rgba(0,0,0,.5);">' + label + '</div>'
    });
}

function matchIcon() {
    return L.divIcon({
        className: '',
        iconSize: [40, 40], iconAnchor: [20, 40], popupAnchor: [0, -42],
        html: '<div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#f97316,#ef4444);border:2px solid #fff;display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;font-weight:700;box-shadow:0 4px 12px rgba(0,0,0,.5);">M</div>'
    });
}

function renderRefMarkers(onRouteIds, assignedIds) {
    onRouteIds  = onRouteIds  || [];
    assignedIds = assignedIds || [];
    Object.values(refMarkers).forEach(m => MAP.removeLayer(m));
    refMarkers = {};
    REFS.forEach(r => {
        if (!r.lat || !r.lon) return;
        var color = assignedIds.includes(r.id) ? '#6366f1' : onRouteIds.includes(r.id) ? '#10b981' : '#3b82f6';
        var m = L.marker([r.lat, r.lon], { icon: refIcon(color, (r.name||'?')[0].toUpperCase()) }).addTo(MAP);
        m.bindPopup(buildRefPopup(r));
        m.on('click', function() { handleRefClick(r); });
        refMarkers[r.id] = m;
    });
}

function buildRefPopup(r) {
    var roleText = r.preferredRole === 'MainReferee' ? 'Main Referee' :
                   r.preferredRole === 'AssistantReferee' ? 'Assistant Referee' : 'No preference';
    var html = '<div class="pp-title">' + r.name + '</div>' +
               '<div class="pp-row">City: <b>' + r.city + '</b></div>' +
               '<div class="pp-row">Role: <b>' + roleText + '</b></div>' +
               (r.hasCar ? '<div class="pp-row">Has a car</div>' : '');
    if (activeSlot) {
        html += '<button class="pp-assign-btn" onclick="assignFromPopup(\'' + r.id.replace(/'/g,"\\'") + '\')">Assign to ' + slotLabel(activeSlot) + '</button>';
    }
    return html;
}

function assignFromPopup(refId) {
    var r = REFS.find(function(x){ return x.id === refId; });
    if (r) handleRefClick(r);
}

function renderRefList(onRouteIds, distMap) {
    onRouteIds = onRouteIds || [];
    distMap    = distMap    || {};
    var container = document.getElementById('ref-list');
    container.innerHTML = '';
    var assignedIds = [slots.main && slots.main.id, slots.asst1 && slots.asst1.id, slots.asst2 && slots.asst2.id].filter(Boolean);

    var sorted = REFS.slice().sort(function(a, b) {
        var aAss = assignedIds.includes(a.id), bAss = assignedIds.includes(b.id);
        var aOn  = onRouteIds.includes(a.id),  bOn  = onRouteIds.includes(b.id);
        if (aAss !== bAss) return aAss ? -1 : 1;
        if (aOn  !== bOn)  return aOn  ? -1 : 1;
        return (a.name||'').localeCompare(b.name||'');
    });

    sorted.forEach(function(r) {
        var hasCoords  = !!(r.lat && r.lon);
        var onRoute    = onRouteIds.includes(r.id);
        var isAssigned = assignedIds.includes(r.id);
        var distKm     = distMap[r.id];

        var roleBadge = r.preferredRole === 'MainReferee'
            ? '<span class="tag tag-main">Main</span>'
            : r.preferredRole === 'AssistantReferee'
            ? '<span class="tag tag-asst">Asst</span>' : '';

        var div = document.createElement('div');
        div.className = 'rc' +
            (onRoute    ? ' on-route'      : '') +
            (isAssigned ? ' assigned-here' : '') +
            (!hasCoords ? ' no-coords'     : '');
        div.dataset.id = r.id;
        div.innerHTML =
            '<div class="rc-av">' + (r.name||'?')[0].toUpperCase() + '</div>' +
            '<div class="rc-info">' +
                '<div class="rc-name">' + r.name + '</div>' +
                '<div class="rc-meta">' + r.city + (!hasCoords ? ' &middot; <i>no coords</i>' : '') + '</div>' +
                '<div class="rc-tags">' +
                    (r.hasCar ? '<span class="tag tag-car">Car</span>' : '') +
                    roleBadge +
                    (onRoute && distKm != null ? '<span class="tag tag-km">' + distKm + 'km off route</span>' : '') +
                    (isAssigned ? '<span class="tag tag-asgn">' + getSlotForRef(r.id) + '</span>' : '') +
                '</div>' +
            '</div>' +
            '<button class="rc-assign-btn' + (activeSlot ? '' : ' hidden') + '" onclick="event.stopPropagation();handleRefClick(' + JSON.stringify(r) + ')">+ Assign</button>';

        if (hasCoords) {
            div.addEventListener('click', function(e) {
                if (e.target.classList.contains('rc-assign-btn')) return;
                if (activeSlot) { handleRefClick(r); return; }
                MAP.flyTo([r.lat, r.lon], 13, { duration: .8 });
                if (refMarkers[r.id]) refMarkers[r.id].openPopup();
                highlightCard(r.id);
            });
        }
        container.appendChild(div);
    });

    var countEl = document.getElementById('ref-count');
    countEl.textContent = onRouteIds.length ? ('(' + onRouteIds.length + ' on route)') : ('(' + REFS.length + ')');
}

function highlightCard(id) {
    document.querySelectorAll('.rc').forEach(function(c){ c.style.outline=''; });
    var c = document.querySelector('.rc[data-id="' + id + '"]');
    if (c) { c.style.outline = '2px solid #0ea5e9'; c.scrollIntoView({ behavior:'smooth', block:'nearest' }); }
}

function getSlotForRef(id) {
    if (slots.main  && slots.main.id  === id) return 'Main';
    if (slots.asst1 && slots.asst1.id === id) return 'Asst1';
    if (slots.asst2 && slots.asst2.id === id) return 'Asst2';
    return '';
}

function onMatchSelected() {
    var id = parseInt(document.getElementById('match-select').value);
    SELECTED_MATCH = MATCHES.find(function(m){ return m.id === id; }) || null;
    clearRoute();
    resetSlots();
    if (!SELECTED_MATCH) {
        document.getElementById('assign-panel').classList.remove('visible');
        document.getElementById('map-hint').style.display = 'block';
        renderRefList();
        return;
    }
    document.getElementById('map-hint').style.display = 'none';
    document.getElementById('assign-panel').classList.add('visible');
    if (SELECTED_MATCH.mainRefereeId) prePopulateSlot('main',  SELECTED_MATCH.mainRefereeId);
    if (SELECTED_MATCH.assistant1Id)  prePopulateSlot('asst1', SELECTED_MATCH.assistant1Id);
    if (SELECTED_MATCH.assistant2Id)  prePopulateSlot('asst2', SELECTED_MATCH.assistant2Id);
    placeMatchMarker();
    computeRoute();
}

function prePopulateSlot(slotKey, refId) {
    var r = REFS.find(function(x){ return x.id === refId; });
    if (r) assignToSlot(slotKey, r);
}

function slotLabel(k) {
    return k === 'main' ? 'Main Referee' : k === 'asst1' ? 'Assistant 1' : 'Assistant 2';
}

function activateSlot(slotKey) {
    if (activeSlot === slotKey) { deactivateSlot(); return; }
    activeSlot = slotKey;
    ['main','asst1','asst2'].forEach(function(k) {
        document.getElementById('slot-' + k).classList.toggle('active', k === slotKey);
    });
    document.getElementById('active-hint').style.display = 'block';
    renderRefList(currentOnRouteIds, currentDistMap);
    REFS.forEach(function(r){ if (r.lat && r.lon && refMarkers[r.id]) refMarkers[r.id].setPopupContent(buildRefPopup(r)); });
}

function deactivateSlot() {
    activeSlot = null;
    ['main','asst1','asst2'].forEach(function(k){ document.getElementById('slot-' + k).classList.remove('active'); });
    document.getElementById('active-hint').style.display = 'none';
    renderRefList(currentOnRouteIds, currentDistMap);
    REFS.forEach(function(r){ if (r.lat && r.lon && refMarkers[r.id]) refMarkers[r.id].setPopupContent(buildRefPopup(r)); });
}

function assignToSlot(slotKey, r) {
    ['main','asst1','asst2'].forEach(function(k){ if (slots[k] && slots[k].id === r.id && k !== slotKey) clearSlotData(k); });
    slots[slotKey] = r;
    var nameEl  = document.getElementById('slot-' + slotKey + '-name');
    var hintEl  = document.getElementById('slot-' + slotKey + '-hint');
    var clearEl = document.getElementById('slot-' + slotKey + '-clear');
    var badge   = r.preferredRole === 'MainReferee' ? ' [Main]' : r.preferredRole === 'AssistantReferee' ? ' [Asst]' : '';
    nameEl.textContent = r.name + (r.hasCar ? ' (Car)' : '') + badge;
    nameEl.style.display = 'block';
    hintEl.style.display  = 'none';
    clearEl.style.display = 'block';
    document.getElementById('slot-' + slotKey).classList.add('filled');
    deactivateSlot();
}

function clearSlotData(slotKey) {
    slots[slotKey] = null;
    document.getElementById('slot-' + slotKey + '-name').style.display  = 'none';
    document.getElementById('slot-' + slotKey + '-hint').style.display  = 'block';
    document.getElementById('slot-' + slotKey + '-clear').style.display = 'none';
    document.getElementById('slot-' + slotKey).classList.remove('filled');
}

function clearSlot(event, slotKey) {
    event.stopPropagation();
    clearSlotData(slotKey);
    renderRefList(currentOnRouteIds, currentDistMap);
}

function resetSlots() {
    ['main','asst1','asst2'].forEach(clearSlotData);
    deactivateSlot();
    setSaveMsg('', '');
}

function handleRefClick(r) {
    if (!activeSlot || !SELECTED_MATCH) return;
    var already = ['main','asst1','asst2'].filter(function(k){ return k !== activeSlot && slots[k] && slots[k].id === r.id; });
    if (already.length) { setSaveMsg(r.name + ' is already in ' + slotLabel(already[0]), 'err'); return; }
    assignToSlot(activeSlot, r);
    renderRefList(currentOnRouteIds, currentDistMap);
    var assignedNow = [slots.main && slots.main.id, slots.asst1 && slots.asst1.id, slots.asst2 && slots.asst2.id].filter(Boolean);
    if (r.lat && r.lon && refMarkers[r.id]) {
        refMarkers[r.id].setIcon(refIcon(assignedNow.includes(r.id) ? '#6366f1' : '#3b82f6', (r.name||'?')[0].toUpperCase()));
    }
    setSaveMsg('', '');
}

async function saveAssignment() {
    if (!SELECTED_MATCH) return;
    var btn = document.getElementById('save-btn');
    btn.disabled = true; btn.textContent = 'Saving...';
    var payload = {
        matchId:       SELECTED_MATCH.id,
        mainRefereeId: slots.main  ? slots.main.id  : null,
        assistant1Id:  slots.asst1 ? slots.asst1.id : null,
        assistant2Id:  slots.asst2 ? slots.asst2.id : null
    };
    try {
        var res  = await fetch('/Board/SaveMapAssignment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': AF_TOKEN },
            body: JSON.stringify(payload)
        });
        var data = await res.json();
        if (res.ok) {
            setSaveMsg('Saved!', 'ok');
            SELECTED_MATCH.mainRefereeId = payload.mainRefereeId;
            SELECTED_MATCH.assistant1Id  = payload.assistant1Id;
            SELECTED_MATCH.assistant2Id  = payload.assistant2Id;
        } else {
            setSaveMsg(data.error || 'Save failed.', 'err');
        }
    } catch(e) {
        setSaveMsg('Network error.', 'err');
    }
    btn.disabled = false; btn.textContent = 'Save Assignments';
}

function setSaveMsg(msg, cls) {
    var el = document.getElementById('save-msg');
    el.textContent = msg;
    el.className   = cls;
}

function placeMatchMarker() {
    if (matchMarkerObj) { MAP.removeLayer(matchMarkerObj); matchMarkerObj = null; }
    if (!SELECTED_MATCH.lat || !SELECTED_MATCH.lon) return;
    matchMarkerObj = L.marker([SELECTED_MATCH.lat, SELECTED_MATCH.lon], { icon: matchIcon() }).addTo(MAP);
    matchMarkerObj.bindPopup(
        '<div class="pp-title">' + SELECTED_MATCH.homeTeam + ' vs ' + SELECTED_MATCH.awayTeam + '</div>' +
        '<div class="pp-row">' + SELECTED_MATCH.date + '</div>' +
        '<div class="pp-row">' + (SELECTED_MATCH.city || 'Unknown city') + '</div>'
    );
}

async function geocodeCity(city) {
    var url = 'https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=ro&q=' + encodeURIComponent(city + ', Romania');
    var res = await fetch(url, { headers: { 'Accept-Language': 'en' } });
    var d   = await res.json();
    return d.length ? { lat: parseFloat(d[0].lat), lon: parseFloat(d[0].lon) } : null;
}

async function computeRoute() {
    if (!SELECTED_MATCH || !SELECTED_MATCH.lat || !SELECTED_MATCH.lon) return;
    var originCity = (document.getElementById('origin-city').value || 'Arad').trim();
    var btn = document.getElementById('route-btn');
    btn.textContent = '...'; btn.disabled = true;

    var origin = ARAD_CENTER;
    if (originCity.toLowerCase() !== 'arad') {
        var g = await geocodeCity(originCity);
        if (g) origin = [g.lat, g.lon];
    }

    var dest = [SELECTED_MATCH.lat, SELECTED_MATCH.lon];
    var url  = OSRM_BASE + '/' + origin[1] + ',' + origin[0] + ';' + dest[1] + ',' + dest[0] + '?overview=full&geometries=geojson';
    var rd;
    try { rd = await (await fetch(url)).json(); }
    catch(e) { btn.textContent = 'Show Route'; btn.disabled = false; return; }

    if (!rd.routes || !rd.routes.length) { btn.textContent = 'Show Route'; btn.disabled = false; return; }

    var route = rd.routes[0];
    routeGeoJSON = route.geometry;
    document.getElementById('ri-dist').textContent = (route.distance/1000).toFixed(1) + ' km';
    document.getElementById('ri-dur').textContent  = Math.round(route.duration/60) + ' min';
    document.getElementById('route-info').classList.add('visible');
    renderRouteBuffer(routeGeoJSON);
    btn.textContent = 'Show Route'; btn.disabled = false;
}

function renderRouteBuffer(geojson) {
    if (routeLayer)  { MAP.removeLayer(routeLayer);  routeLayer  = null; }
    if (bufferLayer) { MAP.removeLayer(bufferLayer); bufferLayer = null; }

    var bufKm = parseInt(document.getElementById('buffer-km').value) || 10;
    routeLayer = L.geoJSON(geojson, { style: { color:'#0ea5e9', weight:5, opacity:.85 } }).addTo(MAP);

    var line     = turf.lineString(geojson.coordinates);
    var buffered = turf.buffer(line, bufKm, { units: 'kilometers' });
    bufferLayer = L.geoJSON(buffered, { style: { fillColor:'#0ea5e9', fillOpacity:.09, color:'#0ea5e9', weight:1.5, opacity:.4, dashArray:'6 4' } }).addTo(MAP);

    currentOnRouteIds = []; currentDistMap = {};
    REFS.forEach(function(r) {
        if (!r.lat || !r.lon) return;
        var pt = turf.point([r.lon, r.lat]);
        if (turf.booleanPointInPolygon(pt, buffered)) {
            currentOnRouteIds.push(r.id);
            var nearest = turf.nearestPointOnLine(line, pt, { units:'kilometers' });
            currentDistMap[r.id] = nearest.properties.dist.toFixed(1);
        }
    });

    var assignedIds = [slots.main && slots.main.id, slots.asst1 && slots.asst1.id, slots.asst2 && slots.asst2.id].filter(Boolean);
    REFS.forEach(function(r) {
        if (!r.lat || !r.lon) return;
        var color = assignedIds.includes(r.id) ? '#6366f1' : currentOnRouteIds.includes(r.id) ? '#10b981' : '#3b82f6';
        if (refMarkers[r.id]) refMarkers[r.id].setIcon(refIcon(color, (r.name||'?')[0].toUpperCase()));
    });

    MAP.fitBounds(bufferLayer.getBounds(), { padding: [40, 40] });
    document.getElementById('ri-onroute').textContent = currentOnRouteIds.length + ' ref' + (currentOnRouteIds.length !== 1 ? 's' : '');
    renderRefList(currentOnRouteIds, currentDistMap);
}

function onBufferChange(val) {
    document.getElementById('buffer-val').textContent = val + ' km';
    if (routeGeoJSON) renderRouteBuffer(routeGeoJSON);
}

function clearRoute() {
    if (routeLayer)  { MAP.removeLayer(routeLayer);  routeLayer  = null; }
    if (bufferLayer) { MAP.removeLayer(bufferLayer); bufferLayer = null; }
    routeGeoJSON = null; currentOnRouteIds = []; currentDistMap = {};
    document.getElementById('route-info').classList.remove('visible');
    REFS.forEach(function(r) {
        if (r.lat && r.lon && refMarkers[r.id])
            refMarkers[r.id].setIcon(refIcon('#3b82f6', (r.name||'?')[0].toUpperCase()));
    });
}
</script>
