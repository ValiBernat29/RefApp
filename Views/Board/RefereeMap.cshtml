@{
    ViewData["Title"] = "Route Map — Arad County Referees";
    Layout = null; // full-screen, own layout
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Route Map · RefApp</title>

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Leaflet Marker Cluster -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; display: flex; height: 100vh; overflow: hidden; background: #0f172a; }

        /* ── Side Panel ───────────────────────────────────────────────── */
        #panel {
            width: 360px;
            flex-shrink: 0;
            background: #1e293b;
            border-right: 1px solid #334155;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        #panel-header {
            padding: 16px 20px;
            background: linear-gradient(135deg, #0ea5e9, #6366f1);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        #panel-header a {
            color: rgba(255,255,255,0.8);
            text-decoration: none;
            font-size: 12px;
        }
        #panel-header a:hover { color: #fff; }
        #panel-header h1 { font-size: 15px; font-weight: 700; color: #fff; }
        #panel-header span { font-size: 11px; color: rgba(255,255,255,0.7); }

        /* ── Match selector ───────────────────────────────────────────── */
        #match-section { padding: 16px; border-bottom: 1px solid #334155; }
        #match-section label { display: block; font-size: 11px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
        #match-select {
            width: 100%;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 8px;
            padding: 9px 12px;
            color: #e2e8f0;
            font-size: 13px;
            font-family: inherit;
            outline: none;
            cursor: pointer;
        }
        #match-select:focus { border-color: #0ea5e9; }
        #match-select option { background: #1e293b; }

        /* ── Route origin ───────────────────────────────────────────── */
        #origin-section { padding: 12px 16px; border-bottom: 1px solid #334155; }
        #origin-section label { display: block; font-size: 11px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 6px; }
        #buffer-row { display: flex; align-items: center; gap: 10px; margin-top: 8px; }
        #buffer-row label { font-size: 11px; color: #94a3b8; white-space: nowrap; }
        #buffer-km { flex: 1; accent-color: #0ea5e9; }
        #buffer-val { font-size: 12px; font-weight: 600; color: #0ea5e9; min-width: 38px; text-align: right; }

        /* ── Route info bar ─────────────────────────────────────────── */
        #route-info {
            padding: 10px 16px;
            background: #0f172a;
            border-bottom: 1px solid #1e293b;
            display: none;
            gap: 16px;
            flex-wrap: wrap;
        }
        #route-info.visible { display: flex; }
        .ri-stat { display: flex; flex-direction: column; }
        .ri-stat span:first-child { font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: .05em; }
        .ri-stat span:last-child { font-size: 14px; font-weight: 700; color: #e2e8f0; }

        /* ── Referee list ───────────────────────────────────────────── */
        #ref-list { flex: 1; overflow-y: auto; padding: 10px; }
        #ref-list::-webkit-scrollbar { width: 4px; }
        #ref-list::-webkit-scrollbar-thumb { background: #334155; border-radius: 2px; }

        .ref-card {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            margin-bottom: 4px;
            cursor: pointer;
            transition: background .15s;
            border: 1px solid transparent;
        }
        .ref-card:hover { background: #0f172a; }
        .ref-card.on-route { background: rgba(16,185,129,.1); border-color: rgba(16,185,129,.3); }
        .ref-card.assigned { background: rgba(99,102,241,.12); border-color: rgba(99,102,241,.4); }
        .ref-card.no-coords { opacity: .45; }

        .ref-avatar {
            width: 36px; height: 36px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 700; flex-shrink: 0;
            background: #334155; color: #94a3b8;
        }
        .ref-card.on-route .ref-avatar { background: rgba(16,185,129,.25); color: #34d399; }
        .ref-card.assigned .ref-avatar { background: rgba(99,102,241,.3); color: #a5b4fc; }

        .ref-info { flex: 1; min-width: 0; }
        .ref-name { font-size: 13px; font-weight: 600; color: #e2e8f0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .ref-meta { font-size: 11px; color: #64748b; margin-top: 1px; }

        .ref-badges { display: flex; gap: 4px; flex-wrap: wrap; }
        .badge-sm {
            padding: 1px 6px; border-radius: 999px; font-size: 10px; font-weight: 600;
        }
        .badge-car  { background: rgba(16,185,129,.15); color: #34d399; }
        .badge-main { background: rgba(14,165,233,.15); color: #38bdf8; }
        .badge-asst { background: rgba(168,85,247,.15); color: #c084fc; }
        .badge-dist { background: rgba(251,191,36,.12); color: #fbbf24; }

        /* ── Legend ───────────────────────────────────────────────── */
        #legend {
            padding: 12px 16px;
            border-top: 1px solid #334155;
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }
        .leg { display: flex; align-items: center; gap: 5px; font-size: 11px; color: #94a3b8; }
        .leg-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }

        /* ── Map ───────────────────────────────────────────────────── */
        #map { flex: 1; position: relative; }

        /* Loading overlay */
        #loading {
            position: absolute;
            inset: 0;
            background: rgba(15,23,42,.85);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            gap: 12px;
        }
        #loading p { color: #94a3b8; font-size: 14px; }
        .spinner {
            width: 36px; height: 36px;
            border: 3px solid #334155;
            border-top-color: #0ea5e9;
            border-radius: 50%;
            animation: spin .8s linear infinite;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }

        #no-match-hint {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%);
            background: rgba(30,41,59,.9);
            backdrop-filter: blur(8px);
            border: 1px solid #334155;
            border-radius: 14px;
            padding: 24px 32px;
            text-align: center;
            z-index: 1000;
            pointer-events: none;
        }
        #no-match-hint .icon { font-size: 42px; margin-bottom: 10px; }
        #no-match-hint p { color: #94a3b8; font-size: 13px; }
        #no-match-hint strong { color: #e2e8f0; }

        /* Leaflet popup override */
        .leaflet-popup-content-wrapper { background: #1e293b; border: 1px solid #334155; border-radius: 10px; color: #e2e8f0; }
        .leaflet-popup-tip { background: #1e293b; }
        .leaflet-popup-content { margin: 12px 14px; font-family: 'Inter', sans-serif; font-size: 13px; }
        .popup-title { font-weight: 700; font-size: 14px; margin-bottom: 4px; }
        .popup-row { color: #94a3b8; margin-top: 3px; }
        .popup-row b { color: #e2e8f0; }
        .popup-on-route { margin-top: 8px; padding: 4px 8px; border-radius: 6px; background: rgba(16,185,129,.15); color: #34d399; font-size: 12px; font-weight: 600; display: inline-block; }
    </style>
</head>
<body>

<!-- ── Side Panel ─────────────────────────────────────────────────── -->
<div id="panel">

    <div id="panel-header">
        <div style="flex:1">
            <a href="/Board">← Back to Dashboard</a>
            <h1>🗺 Route Map</h1>
            <span>Arad County — Referee Locations</span>
        </div>
    </div>

    <!-- Match selector -->
    <div id="match-section">
        <label>Select a Match to Route</label>
        <select id="match-select">
            <option value="">— select a match —</option>
        </select>
    </div>

    <!-- Buffer / origin -->
    <div id="origin-section">
        <label>Route Origin</label>
        <div style="display:flex;gap:8px;align-items:center;">
            <input id="origin-city" type="text" value="Arad"
                   placeholder="Origin city..."
                   style="flex:1;background:#0f172a;border:1px solid #334155;border-radius:8px;padding:8px 10px;color:#e2e8f0;font-size:13px;font-family:inherit;outline:none;" />
            <button id="route-btn" onclick="computeRoute()"
                    style="background:linear-gradient(135deg,#0ea5e9,#6366f1);color:#fff;border:none;border-radius:8px;padding:8px 14px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;">
                Show Route
            </button>
        </div>
        <div id="buffer-row">
            <label>Buffer ±</label>
            <input type="range" id="buffer-km" min="2" max="30" value="10" step="1" oninput="onBufferChange(this.value)" />
            <span id="buffer-val">10 km</span>
        </div>
    </div>

    <!-- Route stats -->
    <div id="route-info">
        <div class="ri-stat"><span>Distance</span><span id="ri-dist">—</span></div>
        <div class="ri-stat"><span>Duration</span><span id="ri-dur">—</span></div>
        <div class="ri-stat"><span>On Route</span><span id="ri-onroute">—</span></div>
    </div>

    <!-- Referee list -->
    <div style="padding:10px 16px 4px;font-size:11px;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.05em;">
        Referees <span id="ref-count" style="color:#0ea5e9;"></span>
    </div>
    <div id="ref-list"></div>

    <!-- Legend -->
    <div id="legend">
        <div class="leg"><div class="leg-dot" style="background:#3b82f6;"></div> Referee</div>
        <div class="leg"><div class="leg-dot" style="background:#10b981;"></div> On route ±<span id="leg-km">10</span>km</div>
        <div class="leg"><div class="leg-dot" style="background:#6366f1;"></div> Assigned</div>
        <div class="leg"><div class="leg-dot" style="background:#f97316;"></div> Match venue</div>
    </div>
</div>

<!-- ── Map ──────────────────────────────────────────────────────────── -->
<div id="map">
    <div id="loading">
        <div class="spinner"></div>
        <p>Loading referee locations…</p>
    </div>
    <div id="no-match-hint" style="display:none;">
        <div class="icon">🗺</div>
        <strong>Select a match above</strong>
        <p style="margin-top:6px;">The route from your origin to the match venue will appear here,<br>with a buffer zone showing which refs are on the way.</p>
    </div>
</div>

<!-- Scripts -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@turf/turf@6.5.0/turf.min.js"></script>

<script>
// ── Constants ──────────────────────────────────────────────────────────────
const ARAD_CENTER = [46.1866, 21.3123];
const OSRM_BASE   = 'https://router.project-osrm.org/route/v1/driving';

// ── State ──────────────────────────────────────────────────────────────────
let MAP, REFS = [], MATCHES = [], SELECTED_MATCH = null;
let refMarkers = {}, matchMarkerLayer = null;
let routeLayer = null, bufferLayer = null;
let currentRouteGeoJSON = null; // the raw LineString from OSRM

// ── Init ───────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async () => {
    // Init Leaflet
    MAP = L.map('map', { zoomControl: false }).setView(ARAD_CENTER, 10);
    L.control.zoom({ position: 'topright' }).addTo(MAP);

    // Dark OpenStreetMap tiles
    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap &copy; CARTO',
        maxZoom: 19
    }).addTo(MAP);

    // Add Arad city marker
    L.circleMarker(ARAD_CENTER, {
        radius: 8, fillColor: '#f59e0b', color: '#fff',
        weight: 2, opacity: 1, fillOpacity: 0.9
    }).addTo(MAP).bindPopup('<div class="popup-title">📍 Arad</div><div class="popup-row">Default route origin</div>');

    await loadData();
    document.getElementById('loading').style.display = 'none';
    document.getElementById('no-match-hint').style.display = 'block';
});

// ── Data loading ───────────────────────────────────────────────────────────
async function loadData() {
    const res  = await fetch('/Board/MapData');
    const data = await res.json();
    REFS    = data.referees;
    MATCHES = data.matches;

    populateMatchDropdown();
    renderRefMarkers();
    renderRefList();
}

function populateMatchDropdown() {
    const sel = document.getElementById('match-select');
    MATCHES.forEach(m => {
        const opt = document.createElement('option');
        opt.value = m.id;
        opt.textContent = `${m.date}  ·  ${m.homeTeam} vs ${m.awayTeam}`;
        if (!m.lat || !m.lon) opt.textContent += ' (no coords)';
        sel.appendChild(opt);
    });
    sel.addEventListener('change', onMatchSelected);
}

// ── Marker icons ───────────────────────────────────────────────────────────
function makeRefIcon(color, label) {
    return L.divIcon({
        className: '',
        iconSize: [32, 32],
        iconAnchor: [16, 16],
        popupAnchor: [0, -18],
        html: `<div style="
            width:32px;height:32px;border-radius:50%;
            background:${color};border:2px solid rgba(255,255,255,.6);
            display:flex;align-items:center;justify-content:center;
            color:#fff;font-size:11px;font-weight:700;
            box-shadow:0 2px 8px rgba(0,0,0,.5);">${label}</div>`
    });
}

function matchIcon() {
    return L.divIcon({
        className: '',
        iconSize: [40, 40],
        iconAnchor: [20, 40],
        popupAnchor: [0, -42],
        html: `<div style="position:relative;">
            <div style="width:40px;height:40px;border-radius:50%;
                background:linear-gradient(135deg,#f97316,#ef4444);
                border:2px solid #fff;
                display:flex;align-items:center;justify-content:center;
                font-size:20px;box-shadow:0 4px 12px rgba(0,0,0,.5);">⚽</div>
        </div>`
    });
}

// ── Render referee markers ─────────────────────────────────────────────────
function renderRefMarkers() {
    // Remove old markers
    Object.values(refMarkers).forEach(m => MAP.removeLayer(m));
    refMarkers = {};

    REFS.forEach(r => {
        if (!r.lat || !r.lon) return;
        const initial = (r.name || '?')[0].toUpperCase();
        const m = L.marker([r.lat, r.lon], { icon: makeRefIcon('#3b82f6', initial) }).addTo(MAP);
        m.bindPopup(buildRefPopup(r));
        m.on('click', () => highlightRefCard(r.id));
        refMarkers[r.id] = m;
    });
}

function buildRefPopup(r, extra) {
    const onRoute = extra?.onRoute;
    const dist    = extra?.distKm;
    return `<div class="popup-title">${r.name}</div>
        <div class="popup-row">📍 <b>${r.city}</b></div>
        <div class="popup-row">⭐ Role: <b>${r.preferredRole}</b></div>
        <div class="popup-row">🏅 Rank: <b>${r.rank}</b></div>
        ${r.hasCar ? '<div class="popup-row">🚗 Has a car</div>' : ''}
        ${onRoute ? `<div class="popup-on-route">✓ On route — ${dist} km off path</div>` : ''}`;
}

// ── Referee list panel ─────────────────────────────────────────────────────
function renderRefList(onRouteIds = [], assignedIds = [], distMap = {}) {
    const container = document.getElementById('ref-list');
    container.innerHTML = '';

    const sorted = [...REFS].sort((a, b) => {
        const aOn = onRouteIds.includes(a.id);
        const bOn = onRouteIds.includes(b.id);
        const aAs = assignedIds.includes(a.id);
        const bAs = assignedIds.includes(b.id);
        if (aAs !== bAs) return aAs ? -1 : 1;
        if (aOn !== bOn) return aOn ? -1 : 1;
        return (a.name || '').localeCompare(b.name || '');
    });

    sorted.forEach(r => {
        const hasCoords = !!(r.lat && r.lon);
        const onRoute   = onRouteIds.includes(r.id);
        const assigned  = assignedIds.includes(r.id);
        const distKm    = distMap[r.id];

        const card = document.createElement('div');
        card.className = 'ref-card' +
            (onRoute  ? ' on-route' : '') +
            (assigned ? ' assigned' : '') +
            (!hasCoords ? ' no-coords' : '');
        card.dataset.id = r.id;
        card.innerHTML = `
            <div class="ref-avatar">${(r.name||'?')[0].toUpperCase()}</div>
            <div class="ref-info">
                <div class="ref-name">${r.name}</div>
                <div class="ref-meta">${r.city}${!hasCoords ? ' · <i>no coords</i>' : ''}</div>
                <div class="ref-badges" style="margin-top:4px;">
                    ${r.hasCar ? '<span class="badge-sm badge-car">🚗 Car</span>' : ''}
                    ${r.preferredRole === 'MainReferee' ? '<span class="badge-sm badge-main">Main</span>' : ''}
                    ${r.preferredRole === 'AssistantReferee' ? '<span class="badge-sm badge-asst">Asst</span>' : ''}
                    ${onRoute && distKm != null ? `<span class="badge-sm badge-dist">${distKm} km off route</span>` : ''}
                    ${assigned ? '<span class="badge-sm" style="background:rgba(99,102,241,.2);color:#a5b4fc;">Assigned</span>' : ''}
                </div>
            </div>`;

        if (hasCoords) {
            card.addEventListener('click', () => {
                MAP.flyTo([r.lat, r.lon], 13, { duration: 0.8 });
                refMarkers[r.id]?.openPopup();
            });
        }
        container.appendChild(card);
    });

    const onRouteWithCoords = onRouteIds.filter(id => REFS.find(r => r.id === id && r.lat));
    document.getElementById('ref-count').textContent =
        onRouteIds.length ? `· ${onRouteWithCoords.length} on route` : `(${REFS.length})`;
}

function highlightRefCard(id) {
    document.querySelectorAll('.ref-card').forEach(c => c.style.outline = '');
    const card = document.querySelector(`.ref-card[data-id="${id}"]`);
    if (card) {
        card.style.outline = '2px solid #0ea5e9';
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
}

// ── Match selection ────────────────────────────────────────────────────────
function onMatchSelected() {
    const id = parseInt(document.getElementById('match-select').value);
    SELECTED_MATCH = MATCHES.find(m => m.id === id) || null;
    clearRoute();
    if (!SELECTED_MATCH) {
        document.getElementById('no-match-hint').style.display = 'block';
        renderRefList();
        return;
    }
    document.getElementById('no-match-hint').style.display = 'none';
    placeMatchMarker();
    computeRoute();
}

function placeMatchMarker() {
    if (matchMarkerLayer) { MAP.removeLayer(matchMarkerLayer); matchMarkerLayer = null; }
    if (!SELECTED_MATCH.lat || !SELECTED_MATCH.lon) return;

    matchMarkerLayer = L.marker([SELECTED_MATCH.lat, SELECTED_MATCH.lon], { icon: matchIcon() }).addTo(MAP);
    matchMarkerLayer.bindPopup(`
        <div class="popup-title">⚽ ${SELECTED_MATCH.homeTeam} vs ${SELECTED_MATCH.awayTeam}</div>
        <div class="popup-row">📅 ${SELECTED_MATCH.date}</div>
        <div class="popup-row">📍 ${SELECTED_MATCH.city || 'unknown city'}</div>`);
}

// ── Routing ────────────────────────────────────────────────────────────────
async function geocodeCity(city) {
    const url = `https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=ro&q=${encodeURIComponent(city + ', Romania')}`;
    const res = await fetch(url, { headers: { 'Accept-Language': 'en' } });
    const data = await res.json();
    if (data.length === 0) return null;
    return { lat: parseFloat(data[0].lat), lon: parseFloat(data[0].lon) };
}

async function computeRoute() {
    if (!SELECTED_MATCH || !SELECTED_MATCH.lat || !SELECTED_MATCH.lon) return;

    // Resolve origin
    const originCity = (document.getElementById('origin-city').value || 'Arad').trim();
    document.getElementById('route-btn').textContent = '…routing';
    document.getElementById('route-btn').disabled = true;

    let origin = ARAD_CENTER;
    if (originCity.toLowerCase() !== 'arad') {
        const geo = await geocodeCity(originCity);
        if (geo) origin = [geo.lat, geo.lon];
        else { alert(`Could not find "${originCity}". Using Arad.`); }
    }

    const dest = [SELECTED_MATCH.lat, SELECTED_MATCH.lon];

    // OSRM request (lon,lat order!)
    const url = `${OSRM_BASE}/${origin[1]},${origin[0]};${dest[1]},${dest[0]}?overview=full&geometries=geojson`;
    let routeData;
    try {
        const res = await fetch(url);
        routeData = await res.json();
    } catch(e) {
        alert('Routing service unavailable. Try again.');
        resetRouteBtn();
        return;
    }

    if (!routeData.routes || routeData.routes.length === 0) {
        alert('Could not compute route.');
        resetRouteBtn();
        return;
    }

    const route = routeData.routes[0];
    currentRouteGeoJSON = route.geometry; // GeoJSON LineString

    // Update stats
    const distKm = (route.distance / 1000).toFixed(1);
    const durMin = Math.round(route.duration / 60);
    document.getElementById('ri-dist').textContent = distKm + ' km';
    document.getElementById('ri-dur').textContent  = durMin + ' min';
    document.getElementById('route-info').classList.add('visible');

    // Render route + buffer
    renderRouteAndBuffer(currentRouteGeoJSON, origin, dest);

    resetRouteBtn();
}

function renderRouteAndBuffer(geojson, origin, dest) {
    clearRoute(false);
    const bufKm = parseInt(document.getElementById('buffer-km').value) || 10;

    // Draw route line
    routeLayer = L.geoJSON(geojson, {
        style: {
            color: '#0ea5e9',
            weight: 5,
            opacity: 0.85,
            dashArray: null
        }
    }).addTo(MAP);

    // Draw buffer polygon via Turf
    const line    = turf.lineString(geojson.coordinates);
    const buffered = turf.buffer(line, bufKm, { units: 'kilometers' });

    bufferLayer = L.geoJSON(buffered, {
        style: {
            fillColor: '#0ea5e9',
            fillOpacity: 0.10,
            color: '#0ea5e9',
            weight: 1.5,
            opacity: 0.4,
            dashArray: '6 4'
        }
    }).addTo(MAP);

    // Check which refs are inside the buffer
    const onRouteIds = [];
    const distMap    = {};

    REFS.forEach(r => {
        if (!r.lat || !r.lon) return;
        const pt = turf.point([r.lon, r.lat]);
        if (turf.booleanPointInPolygon(pt, buffered)) {
            onRouteIds.push(r.id);
            // Distance from ref point to the nearest point on the route line
            const nearest = turf.nearestPointOnLine(line, pt, { units: 'kilometers' });
            distMap[r.id] = nearest.properties.dist.toFixed(1);
        }
    });

    // Update markers
    const assigned = SELECTED_MATCH?.assignedIds || [];
    REFS.forEach(r => {
        if (!r.lat || !r.lon) return;
        const onRoute  = onRouteIds.includes(r.id);
        const isAssign = assigned.includes(r.id);
        const color    = isAssign ? '#6366f1' : onRoute ? '#10b981' : '#3b82f6';
        const initial  = (r.name || '?')[0].toUpperCase();

        refMarkers[r.id]?.setIcon(makeRefIcon(color, initial));
        refMarkers[r.id]?.setPopupContent(buildRefPopup(r, onRoute ? { onRoute: true, distKm: distMap[r.id] } : null));
    });

    // Fit map to route + buffer
    const bounds = bufferLayer.getBounds();
    MAP.fitBounds(bounds, { padding: [40, 40] });

    // Update stats + list
    document.getElementById('ri-onroute').textContent =
        onRouteIds.length + ' ref' + (onRouteIds.length !== 1 ? 's' : '');
    document.getElementById('leg-km').textContent = bufKm;

    renderRefList(onRouteIds, assigned, distMap);
}

// ── Buffer slider ──────────────────────────────────────────────────────────
function onBufferChange(val) {
    document.getElementById('buffer-val').textContent = val + ' km';
    document.getElementById('leg-km').textContent = val;
    if (currentRouteGeoJSON) {
        const origin = null; // don't re-geocode, just re-render
        const dest   = SELECTED_MATCH ? [SELECTED_MATCH.lat, SELECTED_MATCH.lon] : null;
        if (dest) renderRouteAndBuffer(currentRouteGeoJSON, null, dest);
    }
}

// ── Helpers ────────────────────────────────────────────────────────────────
function clearRoute(resetRoute = true) {
    if (routeLayer)  { MAP.removeLayer(routeLayer);  routeLayer = null; }
    if (bufferLayer) { MAP.removeLayer(bufferLayer); bufferLayer = null; }
    if (resetRoute)  { currentRouteGeoJSON = null; }
    document.getElementById('route-info').classList.remove('visible');
    // Reset marker colors
    REFS.forEach(r => {
        if (!r.lat || !r.lon) return;
        refMarkers[r.id]?.setIcon(makeRefIcon('#3b82f6', (r.name||'?')[0].toUpperCase()));
    });
}

function resetRouteBtn() {
    document.getElementById('route-btn').textContent = 'Show Route';
    document.getElementById('route-btn').disabled = false;
}
</script>
</body>
</html>
