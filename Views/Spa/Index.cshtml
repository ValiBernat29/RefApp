@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject RefApp.Services.ViteAssets Vite
@{
    Layout = null;
    var afToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var entry = Vite.GetEntry();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="af-token" content="@afToken" />
    <title>RefApp</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    @* File names carry a content hash, so no ?v= query: the URL must match what the lazy chunks import. *@
    @foreach (var style in entry.Styles)
    {
        <link rel="stylesheet" href="~/@style" />
    }
</head>
<body>
    <div id="app"></div>
    <noscript>RefApp needs JavaScript enabled.</noscript>
    <script type="module" src="~/@entry.Script"></script>
</body>
</html>
